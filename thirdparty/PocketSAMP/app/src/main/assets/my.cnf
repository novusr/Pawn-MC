[mysqld]
# PocketSAMP MariaDB low-memory configuration.
#
# Paths are RELATIVE on purpose. The daemon is started with its working directory set
# to the install root (filesDir/mariadb), so relative paths resolve there whatever the
# application id is. Absolute paths previously hard-coded com.pocketsamp.server, which
# is not PawnMC's package name.
port = 3306
bind-address = 127.0.0.1
socket = ./tmp/mysql.sock
pid-file = ./tmp/mysql.pid
datadir = ./data
tmpdir = ./tmp
lc-messages-dir = ./share/mariadb

# Memory & Flash Optimizations for Android (~35MB RAM footprint)
default-storage-engine = InnoDB
skip-networking = 0
performance_schema = OFF
innodb_buffer_pool_size = 16M
innodb_log_buffer_size = 2M
innodb_flush_log_at_trx_commit = 2
# innodb_flush_method = O_DIRECT
innodb_doublewrite = 0
key_buffer_size = 4M
max_connections = 10
query_cache_type = 0
query_cache_size = 0
table_open_cache = 64
table_definition_cache = 400
thread_stack = 256K
thread_cache_size = 4
open_files_limit = 1024
