[mysqld]
# PocketSAMP MariaDB Ultra-Low Memory Configuration
# user = root
port = 3306
bind-address = 127.0.0.1
socket = /data/data/com.pocketsamp.server/files/mariadb/mysql.sock
pid-file = /data/data/com.pocketsamp.server/files/mariadb/mysql.pid
datadir = /data/data/com.pocketsamp.server/files/mariadb/data
tmpdir = /data/data/com.pocketsamp.server/files/mariadb/tmp
lc-messages-dir = /data/data/com.pocketsamp.server/files/mariadb/share/mariadb

# Memory & Flash Optimizations for Android (~35MB RAM footprint)
default-storage-engine = InnoDB
skip-networking = 0
performance_schema = OFF
innodb_buffer_pool_size = 16M
innodb_log_buffer_size = 2M
innodb_flush_log_at_trx_commit = 2
# innodb_flush_method = O_DIRECT
innodb_doublewrite = 0
key_buffer_size = 4M
max_connections = 10
query_cache_type = 0
query_cache_size = 0
table_open_cache = 64
table_definition_cache = 400
thread_stack = 256K
thread_cache_size = 4
open_files_limit = 1024
